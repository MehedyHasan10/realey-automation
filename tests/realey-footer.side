  "tests": [
    {
      "id": "b370f60e-3024-4e1e-ae34-e5fb9f537845",
      "name": "Footer - Process Link",
      "commands": [
        {
          "id": "fa2b0454-97ba-402e-915c-afc76b76d6a7",
          "command": "open",
          "target": "https://uat.realey.au/",
          "value": ""
        },
        {
          "command": "executeScript",
          "target": "window.scrollTo(0, document.body.scrollHeight)",
          "value": "",
          "id": "a917f7aa-aa83-49fe-bb76-7005f6b55197"
        },
        {
          "command": "click",
          "target": "linkText=Process",
          "value": "",
          "insertBeforeLastCommand": false,
          "frameLocation": "root",
          "winHandleId": "root",
          "id": "0c85c950-531c-4d54-b5d8-1e7847c49025",
          "targets": [
            [
              "linkText=Process",
              "linkText"
            ],
            [
              "css=div:nth-child(1) > .space-y-2 > li:nth-child(3) > .hover\\3Atext-pink-500",
              "css:finder"
            ],
            [
              "xpath=(//a[contains(text(),'Process')])[1]",
              "xpath:link"
            ],
            [
              "xpath=(//div[@id='root']/div[2]/div[2]/footer/div/div/div[2]/div[2]/div/ul/li[3]/a)[1]",
              "xpath:idRelative"
            ],
            [
              "xpath=(//a[contains(@href, '/about/process')])[1]",
              "xpath:href"
            ],
            [
              "xpath=//a[contains(.,'Process')]",
              "xpath:innerText"
            ]
          ]
        },
        {
          "command": "assertElementPresent",
          "target": "xpath=//span[normalize-space()='Process']",
          "value": "Page Not Found",
          "id": "ba99a992-4f1c-479a-943a-224b1f267a34"
        }
      ]
    },
